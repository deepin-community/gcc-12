+(define_mode_iterator ALLVEC_TI [
+    (V2DI "ISA_HAS_LSX") (V4SI "ISA_HAS_LSX") (V8HI "ISA_HAS_LSX") (V16QI "ISA_HAS_LSX") (V2DF "ISA_HAS_LSX") (V4SF "ISA_HAS_LSX")
