+(V2DI "ISA_HAS_LSX") (V4SI "ISA_HAS_LSX") (V8HI "ISA_HAS_LSX") (V16QI "ISA_HAS_LSX") (V2DF "ISA_HAS_LSX") (V4SF "ISA_HAS_LSX")
+(V4DI "ISA_HAS_LASX") (V8SI "ISA_HAS_LASX") (V16HI "ISA_HAS_LASX") (V32QI "ISA_HAS_LASX") (V4DF "ISA_HAS_LASX") (V8SF "ISA_HAS_LASX")])
 
